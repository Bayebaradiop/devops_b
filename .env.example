# Copier ce fichier en .env puis adapter les valeurs.
# Le .env reel n'est JAMAIS commite (voir .gitignore).

# --- Base de donnees ---
DB_NAME=todoapp
DB_USER=todoapp
DB_PASSWORD=changeme
# Nom du service db dans le reseau compose (localhost si l'API tourne hors Docker)
DB_HOST=db
DB_PORT=5432
# Port expose sur la machine hote
DB_PORT_HOST=5439

# --- API ---
SERVER_PORT=8080
# Port expose sur la machine hote
SERVER_PORT_HOST=8090

# --- CORS : origine(s) autorisee(s), separees par des virgules ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
